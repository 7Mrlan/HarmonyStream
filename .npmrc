# Claudio · pnpm 配置
# ----------------------------
# React Native / Expo 生态大量包假设传递依赖能从子目录向上爬找到，
# pnpm 默认的 isolated linker 会导致 "Unable to resolve X" 系列错误。
# 切换为 hoisted 模式（行为类似 npm），所有依赖平铺到根 node_modules。

node-linker=hoisted

# 同时强制提升常见需要被多包看到的 pattern
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*nativewind*
public-hoist-pattern[]=*@babel*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*css-interop*

# 严格 peer 警告关闭，RN 生态版本兼容性误报多
strict-peer-dependencies=false
auto-install-peers=true

# 国内镜像加速
registry=https://registry.npmmirror.com
