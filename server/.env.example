# ===== Claudio Server 环境变量示例 =====
# 复制为 .env 后按需填写，.env 会被 git 忽略

# 服务端口
PORT=8080

# 运行环境：development / production / test
NODE_ENV=development

# 日志等级：fatal / error / warn / info / debug / trace
LOG_LEVEL=info

# App ↔ Server 静态鉴权 token（v1 方案）
# 客户端请求需带 Authorization: Bearer <SHARED_TOKEN>
SHARED_TOKEN=replace-me-with-a-strong-random-string

# ===== LLM 适配器（v1 接入 DeepSeek / 千问 / 智谱）=====
LLM_PROVIDERS=deepseek,qwen,glm
LLM_DEFAULT=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== TTS（v1 默认 Edge TTS，无需配置；可选豆包）=====
TTS_PROVIDERS=edge
TTS_DEFAULT=edge

EDGE_VOICE=zh-CN-XiaoxiaoNeural

DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_VOICE=zh_female_qingxin_v2_mars_bigtts

# ===== NeteaseCloudMusicApi（独立进程，端口默认 3000）=====
NCM_BASE_URL=http://127.0.0.1:3000
NCM_MUSIC_U=
