# ===== Claudio Server 环境变量示例 =====
# 复制为 .env 后按需填写，.env 会被 git 忽略

# 服务端口
PORT=8080

# 运行环境：development / production / test
NODE_ENV=development

# 日志等级：fatal / error / warn / info / debug / trace
LOG_LEVEL=info

# App ↔ Server 静态鉴权 token（v1 方案）
# 客户端请求需带 Authorization: Bearer <SHARED_TOKEN>
SHARED_TOKEN=replace-me-with-a-strong-random-string

# ===== LLM 适配器（v1 接入 DeepSeek / 千问 / 智谱）=====
LLM_PROVIDERS=deepseek,qwen,glm
LLM_DEFAULT=deepseek
LLM_TIMEOUT_MS=6000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_TYPE=disabled

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ===== 音乐来源（Phase D / Phase D.5）=====
# Phase D 兼容开关：disabled / ncm。Phase D.5 起优先使用 MUSIC_PROVIDER_CHAIN。
MUSIC_PROVIDER=disabled
# provider 优先级链；逗号分隔。可用值：local / external / ncm / fallback。
# 留空时由 registry 根据其它配置推导默认链。
MUSIC_PROVIDER_CHAIN=
# 本地自有音源目录绝对路径；为空时本地 provider 自动禁用。
MUSIC_LIBRARY_DIR=
# /media/local/:id 对外的根地址，例如 http://192.168.1.10:8080。为空时不挂 media 路由。
MEDIA_BASE_URL=
# 外部 HTTP resolver 根地址，POST /search、POST /resolve、GET /manifest。
EXTERNAL_MUSIC_RESOLVER_URL=
EXTERNAL_MUSIC_RESOLVER_TIMEOUT_MS=3500
# NCM 兼容 HTTP 服务（experimental，外部源默认短 TTL，不缓存音频）。
MUSIC_API_BASE_URL=
MUSIC_TIMEOUT_MS=3500
# provider 解析结果内存缓存。
MUSIC_CACHE_MAX_ENTRIES=128
MUSIC_CACHE_DEFAULT_TTL_MS=300000
# 是否后台预解析下一首；4G 下也保持开启不会下载音频，仅做元数据/封面预热。
MUSIC_PRELOAD_ENABLED=true

# ===== TTS（Phase E v1 默认 Edge TTS，无需配置；豆包占位待 Phase G）=====
# provider 优先级链；逗号分隔。可用值：edge / doubao。留空走默认 edge。
TTS_PROVIDER_CHAIN=
# 默认音色，Edge 支持的 zh-CN-* 列表见 msedge-tts。
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
# 单次合成超时（毫秒）。
TTS_TIMEOUT_MS=8000
# audioStore + cache key 表的 LRU/TTL 上限。
TTS_CACHE_MAX_ENTRIES=32
TTS_CACHE_TTL_MS=300000

# 豆包 v1 仅占位，未实现真实合成；填写后 isEnabled 才会变 true。
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_VOICE=

# ===== NeteaseCloudMusicApi（独立进程，端口默认 3000）=====
NCM_BASE_URL=http://127.0.0.1:3000
NCM_MUSIC_U=
