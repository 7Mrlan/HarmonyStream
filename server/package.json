{
  "name": "@claudio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "pnpm exec tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "pnpm exec tsc --noEmit",
    "lint": "pnpm exec eslint src --ext .ts",
    "smoke:radio": "pnpm build && node ../node_modules/tsx/dist/cli.mjs scripts/smoke-radio.ts"
  },
  "dependencies": {
    "@claudio/api": "workspace:*",
    "@fastify/websocket": "^10.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "msedge-tts": "2.0.5",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@claudio/tsconfig": "workspace:*",
    "@types/node": "^20.11.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}
