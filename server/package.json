{
  "name": "@claudio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm exec tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "pnpm exec tsc --noEmit",
    "lint": "pnpm exec eslint src --ext .ts"
  },
  "dependencies": {
    "@claudio/api": "workspace:*",
    "fastify": "^4.28.1",
    "@fastify/websocket": "^10.0.1",
    "dotenv": "^16.4.5",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@claudio/tsconfig": "workspace:*",
    "@types/node": "^20.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
