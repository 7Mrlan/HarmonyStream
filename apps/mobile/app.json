{
  "expo": {
    "name": "Claudio",
    "slug": "claudio",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "claudio",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "android": {
      "package": "fm.claudio.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "permissions": [
        "INTERNET",
        "WAKE_LOCK"
      ]
    },
    "ios": {
      "bundleIdentifier": "fm.claudio.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
