{
  "expo": {
    "name": "Claudio",
    "slug": "claudio",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "claudio",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "android": {
      "package": "fm.claudio.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "ios": {
      "bundleIdentifier": "fm.claudio.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-android-keyboard-fix",
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6e4e160-0a4f-4ab1-b58d-d51cbb8f40ea"
      }
    },
    "owner": "lanwenxing"
  }
}
